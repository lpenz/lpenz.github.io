import os

pjoin = os.path.join

if False:
    Import = None
    env = None

Import(["env"])

if False:
    env.R("main.RData", "main.R")
env.Depends("main.RData", "duinfospike.dat")

for i in [
    "usd",
    "mcs",
    "mcs3",
    "mcsdaydens",
    "mcsbox",
    "mcsquant",
    "mcsquantbar",
    "mcsquantheat",
    "mcspf1",
    "mcscv1",
    "mcscv2",
]:
    env.Command(
        i + ".png",
        ["main.RData", "plot.R", "funcs.R", i + "plot.R"],
        "./plot.R " + i,
        chdir=1,
    )
    env.HTMLSITEFILES.add(pjoin("articles/df0pred-3", i + ".png"))

for i in ["mcsquantheat", "mcspf1", "mcscv1", "mcscv2"]:
    env.Depends(i + ".png", "quantheatplotfunc.R")
    env.HTMLSITEFILES.add(pjoin("articles/df0pred-3", i + ".png"))

env["PANDOC_TEMPLATE"] = env.File("../../templates/pandoctoc.tmpl.html")

env.PANDOC(
    "_index.bhtml.mako.sed",
    "index.md",
    PANDOCFLAGS="-N -s -t html --toc --template=$PANDOC_TEMPLATE",
)
env.Depends("_index.bhtml.mako.sed", env["PANDOC_TEMPLATE"])
env.Command(
    "_index.bhtml.mako",
    "_index.bhtml.mako.sed",
    r"""sed -e 's@{\(.\?\)b}@<\1b>@g' $SOURCE > $TARGET""",
)
env.MAKO("index.html", "_index.bhtml.mako", MAKOFLAGS="-t htmlpage")

env.HTMLSITEFILES.add("articles/df0pred-3/index.html")
