import os

pjoin = os.path.join

if False:
    Import = None
    env = None

Import(["env"])

if False:
    env.R("main.RData", "main.R")
env.Depends("main.RData", "duinfo.dat")

env.R("pointplot.png", "output.R", chdir=1)
env.HTMLSITEFILES.add("articles/df0pred-1/pointplot.png")
env.HTMLSITEFILES.add("articles/df0pred-1/lmplot.png")

env["PANDOC_TEMPLATE"] = env.File("../../templates/pandoctoc.tmpl.html")

env.PANDOC(
    "_index.bhtml.mako.sed",
    "index.md",
    PANDOCFLAGS="-N -s -t html --toc --template=$PANDOC_TEMPLATE",
)
env.Depends("_index.bhtml.mako.sed", env["PANDOC_TEMPLATE"])
env.Command(
    "_index.bhtml.mako",
    "_index.bhtml.mako.sed",
    r"""sed -e 's@{\(.\?\)b}@<\1b>@g' $SOURCE > $TARGET""",
)
env.MAKO("index.html", "_index.bhtml.mako", MAKOFLAGS="-t htmlpage")

env.HTMLSITEFILES.add("articles/df0pred-1/index.html")
